{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://abxvamwcjiqpahfipwqp.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "doctylia-mcp",
      "version": "0.1.0",
      "title": "Doctylia"
    },
    "tools": [
      {
        "name": "get_my_profile",
        "title": "Get my doctor profile",
        "description": "Return the signed-in doctor's Doctylia profile (name, specialization, slug, plan, contact details).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_dashboard_stats",
        "title": "Get dashboard stats",
        "description": "Return quick counts for the signed-in doctor: total patients, total appointments, today's appointments, and pending appointments.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_appointments",
        "title": "List appointments",
        "description": "List the signed-in doctor's appointments. Optionally filter by status, a date range, or limit the result count.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "confirmed",
                "completed",
                "cancelled",
                "no_show"
              ],
              "description": "Filter by appointment status."
            },
            "from_date": {
              "type": "string",
              "description": "Start date (YYYY-MM-DD), inclusive."
            },
            "to_date": {
              "type": "string",
              "description": "End date (YYYY-MM-DD), inclusive."
            },
            "limit": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 200,
              "description": "Max rows to return. Default 50."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_patients",
        "title": "List patients",
        "description": "List patients belonging to the signed-in doctor. Optional text search by name or phone.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "description": "Substring match against patient name or phone."
            },
            "limit": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 200,
              "description": "Max rows. Default 50."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_reviews",
        "title": "List patient reviews",
        "description": "List patient reviews for the signed-in doctor. Optionally filter by minimum star rating.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "min_rating": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "Only return reviews with rating >= this value."
            },
            "limit": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 200
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
